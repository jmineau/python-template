name: Publish

{% if publish_to_pypi -%}
# Pushing a vX.Y.Z tag (see `just release`) builds the package from that tag,
# publishes it to PyPI with trusted publishing, and creates a GitHub Release
# from the tag's CHANGELOG.md section. Zenodo archives each GitHub Release.
{% else -%}
# Pushing a vX.Y.Z tag (see `just release`) builds the package from that tag and
# creates a GitHub Release from the tag's CHANGELOG.md section. Zenodo archives
# each GitHub Release.
{% endif -%}
#
# Every action here is pinned to a commit SHA, not a tag: this workflow can change
# what users install (the release job has `id-token: write`), and a moved tag would
# run new code with no pull request. Dependabot updates the SHA and the version
# comment together. Other workflows keep tag pins (.github/zizmor.yml).
#
# Keep this file's name: {% if publish_to_pypi %}the PyPI trusted publisher is registered for it.{% else %}a PyPI trusted publisher would be registered for it.{% endif %}
on:
  push:
    tags: ["v*"]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    env:
      UV_NO_SYNC: "1"  # `just` recipes run in the environment synced below
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0  # setuptools-scm reads the version from tags

      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "{{ uv_version }}"
          python-version: "{{ python_max }}"

      - name: Install
        run: uv sync --locked

      - name: Build and check
        run: uv run just dist

      - name: Check the version matches the tag
        run: |
          version="$(uv run python -m setuptools_scm)"
          if [ "v$version" != "$GITHUB_REF_NAME" ]; then
            echo "::error::setuptools-scm computed $version, but the tag is $GITHUB_REF_NAME"
            exit 1
          fi

      # Here, before the upload to PyPI: a release without notes must not publish.
      - name: Extract the CHANGELOG section
        run: |
          version="${GITHUB_REF_NAME#v}"
          awk -v v="$version" '
            index($0, "## [" v "]") == 1 { found = 1; next }
            /^## \[/ { if (found) exit }
            found { print }
          ' CHANGELOG.md > release-notes.md
          test -s release-notes.md || { echo "::error::CHANGELOG.md has no '## [$version]' section"; exit 1; }

      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: dist
          path: dist/

      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: release-notes
          path: release-notes.md
{% if publish_to_pypi %}
  publish-pypi:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: pypi
      url: https://pypi.org/p/{{ distribution_name }}
    permissions:
      id-token: write  # trusted publishing (OIDC); also signs attestations
    steps:
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: dist
          path: dist/

      - uses: pypa/gh-action-pypi-publish@7245906fb61fa33a13554f9d5fb856fe61758086 # v1.14.3
{% endif %}
  github-release:
    needs: {% if publish_to_pypi %}publish-pypi{% else %}build{% endif %}
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: dist
          path: dist/

      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: release-notes

      - name: Create the GitHub Release
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          prerelease=()
          # PEP 440 pre-releases (a, b, rc) and dev releases
          if [[ "$GITHUB_REF_NAME" =~ (a|b|rc)[0-9]+$|\.dev[0-9]+$ ]]; then prerelease=(--prerelease); fi
          gh release create "$GITHUB_REF_NAME" dist/* --verify-tag \
            --title "$GITHUB_REF_NAME" --notes-file release-notes.md "${prerelease[@]}"
