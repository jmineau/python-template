cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: "{{ project_name }}"
# After the first Zenodo release, add the concept DOI (it always resolves to the
# latest version) both as `doi:` (which GitHub's "Cite this repository" renders)
# and under `identifiers:`. Versions and release dates are deliberately not
# tracked here: they go stale, and the concept DOI covers every version.
# doi: "10.5281/zenodo.XXXXXXX"
abstract: "{{ project_short_description }}"
authors:
{%- if ' ' in full_name.strip() %}
  - given-names: "{{ full_name.strip().rsplit(' ', 1)[0] }}"
    family-names: "{{ full_name.strip().rsplit(' ', 1)[1] }}"
{%- else %}
  - name: "{{ full_name }}"
{%- endif %}
    email: {{ email }}
{%- if orcid %}
    orcid: "https://orcid.org/{{ orcid }}"
{%- endif %}
{%- if affiliation %}
    affiliation: "{{ affiliation }}"
{%- endif %}
license: MIT
repository-code: "https://github.com/{{ github_username }}/{{ repository_name }}"
url: "https://{{ github_username }}.github.io/{{ repository_name }}/"
# identifiers:
#   - type: doi
#     value: "10.5281/zenodo.XXXXXXX"
#     description: "The concept DOI for all versions of {{ project_name }}."
