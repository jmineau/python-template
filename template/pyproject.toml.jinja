[build-system]
requires = ["setuptools>=77", "setuptools-scm>=8"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ distribution_name }}"
dynamic = ["version"]  # from git tags, via setuptools-scm
description = "{{ project_short_description }}"
readme = "README.md"
requires-python = ">={{ python_min }}"
license = "MIT"
license-files = ["LICENSE"]
authors = [
    {name = "{{ full_name }}", email = "{{ email }}"},
]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Science/Research",
    "Programming Language :: Python :: 3",
{%- for minor in range(python_min_minor, python_max_minor + 1) %}
    "Programming Language :: Python :: 3.{{ minor }}",
{%- endfor %}
    "Typing :: Typed",
]
dependencies = []

[project.urls]
Homepage = "https://github.com/{{ github_username }}/{{ repository_name }}"
Documentation = "https://{{ github_username }}.github.io/{{ repository_name }}/"
Repository = "https://github.com/{{ github_username }}/{{ repository_name }}"
Issues = "https://github.com/{{ github_username }}/{{ repository_name }}/issues"
Changelog = "https://github.com/{{ github_username }}/{{ repository_name }}/blob/main/CHANGELOG.md"

[dependency-groups]
# Dev tooling and docs together; `uv sync` installs it by default.
dev = [
    "docstr-coverage>=2.3",
    "git-cliff>=2.10",  # `just changelog`
    "pre-commit>=4.0",
    "pydata-sphinx-theme>=0.16",
    "pyrefly>=1.3",
    "pytest>=9.0",
    "pytest-cov>=6.0",
    "pytest-xdist>=3.6",
    "ruff>=0.16",
    "rust-just>=1.40",
    "setuptools-scm>=8",  # `just version`
    "sphinx>=8.1",
    "sphinx-autobuild>=2024.10",  # `just docs-serve`
    "sphinx-autodoc-typehints>=3.0",
    "sphinx-copybutton>=0.5",
    "twine>=6.0",  # `just dist`
]

[tool.coverage.run]
source = ["{{ package_name }}"]
branch = true

[tool.coverage.report]
show_missing = true
exclude_also = [
    "if TYPE_CHECKING:",
    "if __name__ == .__main__.:",
    "raise NotImplementedError",
    "@(abc\\.)?abstractmethod",
    "def __repr__",
]

[tool.pyrefly]
project-includes = ["src"]

[tool.pytest]
minversion = "9.0"
testpaths = ["tests"]
strict = true  # strict markers, config, xfail and parametrize ids
addopts = ["-ra"]
log_level = "INFO"  # show captured logs for failing tests
# Warnings are errors, so deprecations surface early. Ignore a specific
# third-party warning with e.g. "ignore:some message:DeprecationWarning:pkg".
filterwarnings = ["error"]
markers = [
    "network: needs live network access; excluded from default runs",
    "slow: expensive in time, bandwidth or disk; excluded from default runs",
]

[tool.repo-review]
# Scientific Python repo-review (`uvx --from "sp-repo-review[cli]" sp-repo-review .`)
# checks that this template skips on purpose:
ignore = [
    "PY007",  # task runner: just, not nox/tox
    "MY101",  # pyrefly's default preset; tighten per project
    "PC110", "PC190",  # ruff runs as a local `uv run` hook, so uv.lock pins its version
    "PC140",  # pyrefly runs as a local `uv run` hook, so it sees the project's dependencies
    "PC160",  # no spell checker
    "PC180",  # no markdown formatter
    "PC901", "PC902", "PC903",  # pre-commit.ci is not used
]

[tool.ruff]
# target-version comes from project.requires-python

[tool.ruff.format]
docstring-code-format = true

[tool.ruff.lint]
select = [
    "E",  # pycodestyle
    "F",  # Pyflakes
    "UP",  # pyupgrade
    "B",  # flake8-bugbear
    "SIM",  # flake8-simplify
    "I",  # isort
    "D213",  # docstring summary on the second line
    "NPY",  # NumPy-specific, incl. NumPy 2 deprecations
    "RUF100",  # unused noqa
]
ignore = [
    "E501",  # line too long, handled by formatter
]

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
"{{ package_name }}" = ["py.typed"]

[tool.setuptools_scm]
# Releases are git tags vX.Y.Z (see CONTRIBUTING.md). Between releases the
# version is the next patch as a dev version, e.g. 0.2.1.dev3+g1a2b3c4.
fallback_version = "0.0.0"  # no git metadata at all (e.g. a bare source copy)

[tool.uv]
required-version = ">={{ uv_version.rsplit('.', 1)[0] }}"
# Rebuild the editable install when pyproject.toml or the git state changes, so
# `__version__` follows new commits and tags.
cache-keys = [{ file = "pyproject.toml" }, { git = { commit = true, tags = true } }]
