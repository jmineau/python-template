repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-added-large-files
      - id: check-json
      - id: check-toml
      - id: check-merge-conflict
      - id: debug-statements

  - repo: https://github.com/pre-commit/pygrep-hooks
    rev: v1.10.0
    hooks:
      - id: rst-backticks
      - id: rst-directive-colons
      - id: rst-inline-touching-normal

  - repo: https://github.com/abravalheri/validate-pyproject
    rev: "0.26"
    hooks:
      - id: validate-pyproject

  # Keep uv.lock in step with pyproject.toml. The rev is the uv version, and
  # matches the one CI pins, so the hook writes a lock CI can read.
  - repo: https://github.com/astral-sh/uv-pre-commit
    rev: {{ uv_version }}
    hooks:
      - id: uv-lock

  # Keep the rev equal to the ruff version in uv.lock, so the hook and
  # `just lint` agree.
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.16.10
    hooks:
      - id: ruff-check
        args: [--fix, --show-fixes]
      - id: ruff-format

  # Security audit of the GitHub Actions workflows (policy in .github/zizmor.yml).
  - repo: https://github.com/zizmorcore/zizmor-pre-commit
    rev: v1.30.1
    hooks:
      - id: zizmor

  - repo: local
    hooks:
      # Runs in the project environment, so third-party imports resolve.
      # --no-sync: a hook never re-syncs .venv (run `just sync` after changing
      # dependencies).
      - id: pyrefly
        name: pyrefly
        entry: uv run --no-sync pyrefly check
        language: system
        types: [python]
        pass_filenames: false
